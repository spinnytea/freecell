{
  "name": "freecell",
	"description": "A playable freecell solitaire web app that can be used offline after the first load.",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "prebuild": "npm run clean && npm run fix && npm run test:cov",
    "build": "next build && node scripts/write-service-worker.mjs",
    "serve": "npx http-server -a localhost -p 8080 -o /freecell/manualtesting out",
    "fix": "npm run lint && npm run format",
    "lint": "next lint --fix && tsc --noEmit",
    "format": "prettier --write --list-different .",
    "test": "vitest -u all",
    "test:cov": "vitest run --coverage",
    "term": "tsx src/terminal/term.ts",
    "checkGames": "tsx src/terminal/checkGames.ts",
    "solveGame": "tsx src/terminal/solveGame.ts",
    "clean": "rm -rf out coverage",
    "clean:deep": "rm -rf out coverage .next node_modules/.cache "
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "chalk": "^5.6.2",
    "http-server": "^14.1.1",
    "next": "^15.4.4",
    "react": "^18",
    "react-dom": "^18",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/chalk": "^2.2.4",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/typescript-estree": "^7",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.20",
    "classnames": "^2.5.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "prettier": "^3.9.4",
    "typescript": "=5.4.5",
    "vitest": "^4.1.9"
  }
}
